{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "lst: build image and run unit tests (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "lst: build unit test image",
            "program": "${workspaceFolder}/build/Debug/lst.exe",
            "args": [ "bin/test.img" ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "lst: build image and run shell (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "lst: build shell image",
            "program": "${workspaceFolder}/build/Debug/lst.exe",
            "args": [ "bin/lst.img" ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "lst: build image and run unit tests (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "lst: build unit test image",
            "program": "${workspaceFolder}/build/Debug/lst",
            "args": [ "bin/test.img" ],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "lst: build image and run shell (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "lst: build shell image",
            "program": "${workspaceFolder}/build/Debug/lst",
            "args": [ "bin/lst.img" ],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "lst: build image and run unit tests (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "lst: build unit test image",
            "program": "${workspaceFolder}/build/Debug/lst",
            "args": [ "bin/test.img" ],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "lst: build image and run shell (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "lst: build shell image",
            "program": "${workspaceFolder}/build/Debug/lst",
            "args": [ "bin/lst.img" ],
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "lldb"
        }
    ]
}
